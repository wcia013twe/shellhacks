{
  "manifest_version": 3,
  "name": "Eye Tracking Attention Analyzer",
  "version": "1.0.0",
  "description": "Analyze user attention patterns with eye tracking and provide accessibility insights.",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["Report/content.js"],
      "css": ["Report/content.css"]
    }
  ],
  "action": {
    "default_popup": "Report/popup.html",
    "default_title": "Show Attention Report"
  },
  "web_accessible_resources": [
    {
      "resources": ["Report/*.js", "Report/*.css", "EyeTracking/js/*.js", "EyeTracking/*.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
